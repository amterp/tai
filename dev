#!/usr/bin/env rad
---
Development helper script for tai.
Provides common development tasks like building, testing, and linting.
---

args:
    validate v bool  # Build, test, and lint
    build b bool     # Build the tai binary
    docs d bool      # Serve docs site locally

if not validate and not build and not docs:
    print_err("No action specified. Use --validate/-v, --build/-b, or --docs/-d")
    exit(1)

// Builds and tests share this machine through Quartermaster: `qm docs projects`.
heavy = (build or validate) and not docs
if heavy and get_env("QM_DEV_WRAPPED") == "" and (quiet $`command -v qm > /dev/null`).ok:
    // History keys estimates by kind, so the kind names the modes asked for.
    kind = "./dev -" + (build ? "b" : "") + (validate ? "v" : "")
    // Each argument is quoted for the shell that runs the line, so values with spaces or quotes
    // reach the re-run copy as they were given.
    args = get_args()
    if args[0] == "dev":
        args[0] = "./dev"
    words = ["'" + a.replace("'", "'\\''") + "'" for a in args]
    relaunch = "env QM_DEV_WRAPPED=1 qm run --kind '{kind}' --wait-at-most 2m -- " + join(words, " ")
    exit($(relaunch).code)

qm_cores = get_env("QM_CORES")
go_parallelism = qm_cores == "" ? [] : ["-p", qm_cores]
golangci_concurrency = qm_cores == "" ? [] : ["--concurrency", qm_cores]

if build or validate:
    do_build()

if validate:
    do_test()
    do_lint()
    print("\n✓ All validations passed!")

if docs:
    do_docs()

fn do_build():
    print("Building tai...")
    $`mkdir -p bin && go build {go_parallelism} -o bin/tai ./cmd/tai`
    print("✓ Build complete: ./bin/tai")

fn do_test():
    print("\nRunning tests...")
    $`go test {go_parallelism} ./...`

fn do_lint():
    print("\nRunning golangci-lint...")
    code = $`golangci-lint run {golangci_concurrency} ./...` catch:
        if code == 127:
            print_err("golangci-lint not installed. Install with: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest")
            exit(1)
        exit(code)

fn do_docs():
    print("Serving docs at http://localhost:4321 ...")
    $`cd docs && npm run dev`
